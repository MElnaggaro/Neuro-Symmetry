# Neuro-Symmetry V2 — backend inference service
# Build:  docker build -f Dockerfile.v2 -t neuro-symmetry-v2 .
# Run via compose: docker compose up --build

FROM python:3.12-slim

WORKDIR /app

# System libs required by OpenCV and MediaPipe
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 libgomp1 libgles2 libegl1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .

# Torch/torchvision are training-only — ONNX runtime handles inference
RUN pip install --no-cache-dir \
    "fastapi>=0.111" \
    "uvicorn[standard]>=0.30" \
    "python-multipart>=0.0.9" \
    "websockets>=12.0" \
    "pydantic-settings>=2.3" \
    "mediapipe>=0.10" \
    "opencv-python-headless>=4.9" \
    "onnxruntime>=1.18" \
    "numpy>=1.26" \
    "scipy>=1.13" \
    "joblib>=1.4" \
    "Pillow>=10.3" \
    "pandas>=2.2" \
    "tqdm>=4.66"

COPY backend/ backend/
COPY ai/      ai/

# ── Runtime configuration — override via environment variables ───────────────
# All settings use the NS_ prefix (see backend/core/config.py).
# Examples:
#   NS_LOG_LEVEL=DEBUG
#   NS_CORS_ORIGINS=https://app.example.com
#   NS_QUALITY__MIN_LAPLACIAN=60
ENV NS_LOG_LEVEL=INFO

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "backend.api.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
